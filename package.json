{
  "name": "kira-core",
  "version": "1.0.0",
  "description": "Kira Core v1.0 - Cerebro IA de DesignSoft Omnichannel AI (Express + TypeScript + Google Gemini)",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "start": "node dist/server.js",
    "dev": "node --watch --import tsx src/server.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@google/genai": "^0.7.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
